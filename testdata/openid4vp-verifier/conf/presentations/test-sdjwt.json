{
  "id": "test-sdjwt",
  "name": "Test SD-JWT Verification",
  "purpose": "Verify SD-JWT credentials issued by veramo-agent",
  "query": {
    "credentials": [
      {
        "id": "test-credential",
        "format": "dc+sd-jwt",
        "meta": {
          "vct_values": ["https://localhost:8443/vct/test"]
        },
        "claims": [
          { "path": ["given_name"] },
          { "path": ["email"] }
        ]
      }
    ]
  }
}
